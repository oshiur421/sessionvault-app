# SessionVault — environment (Flutter)
#
# Supabase is used for LOGIN ONLY. Notes and audio stay on the phone and are
# never sent to Supabase.
#
# Pass these as --dart-define flags when building/running, e.g.:
#   flutter run --dart-define=SUPABASE_URL=https://xyzcompany.supabase.co \
#               --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi...
#   flutter build apk --debug \
#               --dart-define=SUPABASE_URL=https://xyzcompany.supabase.co \
#               --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi...
#
# NEVER put a real key in this file, in the code, or in chat.
# NEVER use the Supabase service_role (secret) key in this app — the anon
# (publishable) key only.
#
# If these are left empty, the app runs in DEMO mode: any email/password
# works locally and login is stored on the device only — same as the web app.

SUPABASE_URL=
SUPABASE_ANON_KEY=
